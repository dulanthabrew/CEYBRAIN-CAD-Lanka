# CAD Lanka Engineering — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# ─── Sanity ──────────────────────────────────────────────────────────────────
# Found at: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-read-token

# ─── Contact Form (Resend) ────────────────────────────────────────────────────
# https://resend.com — server-side only, never exposed to the browser
RESEND_API_KEY=re_your_resend_api_key

# The email address that receives contact form submissions
CONTACT_EMAIL_TO=rangana@cadlankaeng.com

# The from address used when sending (must be a verified Resend domain/address)
CONTACT_EMAIL_FROM=noreply@cadlankaeng.com
